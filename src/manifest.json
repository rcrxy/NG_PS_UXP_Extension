{
    "id": "com.example.ngextension",
    "name": "NGExtension",
    "version": "0.2.2",
    "main": "main.js",
    "host": {
        "app": "PS",
        "minVersion": "22.0.0"
    },
    "manifestVersion": 4,
    "entrypoints": [
        {
            "type": "panel",
            "label": {
                "default": "参考线生成器"
            },
            "id": "guide-panel",
            "icons": [
                {
                    "width": 23,
                    "height": 23,
                    "path": "asset/icons/plus-dark.png",
                    "scale": [
                        1,
                        2
                    ],
                    "theme": [
                        "darkest",
                        "dark",
                        "medium"
                    ]
                },
                {
                    "width": 23,
                    "height": 23,
                    "path": "asset/icons/plus-light.png",
                    "scale": [
                        1,
                        2
                    ],
                    "theme": [
                        "lightest",
                        "light"
                    ]
                }
            ],
            "minimumSize": {
                "width": 240,
                "height": 250
            },
            "maximumSize": {
                "width": 1600,
                "height": 1600
            }
        },
        {
            "type": "command",
            "label": {
                "default": "自定义导出"
            },
            "id": "tailoring-command",
            "icons": [
                {
                    "width": 23,
                    "height": 23,
                    "path": "asset/icons/Tailoring.png",
                    "scale": [
                        1,
                        2
                    ],
                    "theme": [
                        "darkest",
                        "dark",
                        "medium",
                        "lightest",
                        "light"
                    ]
                }
            ]
        }
    ],
    "icons": [
        {
            "width": 23,
            "height": 23,
            "path": "asset/icons/plus-dark.png",
            "scale": [
                1,
                2
            ],
            "theme": [
                "darkest",
                "dark",
                "medium"
            ]
        },
        {
            "width": 23,
            "height": 23,
            "path": "asset/icons/plus-light.png",
            "scale": [
                1,
                2
            ],
            "theme": [
                "lightest",
                "light"
            ]
        }
    ]
}
