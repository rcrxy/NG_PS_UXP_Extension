{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "checkJs": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "lib": [
            "ES2020",
            "DOM"
        ]
    },
    "include": [
        "main.js",
        "src/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "out",
        ".git"
    ]
}
